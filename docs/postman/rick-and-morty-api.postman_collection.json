                ]
              }
            }
          ]
        },
        {
          "name": "Get all locations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/locations/all",
            "description": "Retorna a coleção completa usada na tela geral de Localizações."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns locations', () => pm.expect(pm.response.json().locations).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get location with sorted residents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/locations/{{locationId}}",
            "description": "Expande residentes e aplica a mesma ordenação determinística usada nos episódios."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Residents are deterministically sorted', function () {",
                  "  const residents = pm.response.json().residents;",
                  "  const compare = (left, right) => left.name.localeCompare(right.name, 'pt-BR', { sensitivity: 'base', numeric: true }) || left.id - right.id;",
                  "  const expected = [...residents].sort(compare).map(item => item.id);",
                  "  pm.expect(residents.map(item => item.id)).to.eql(expected);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get locations batch",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/locations/batch?ids=3,21,3"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Deduplicates and preserves order', () => pm.expect(pm.response.json().locations.map(item => item.id)).to.eql([3, 21]));"
                ]
              }
            }
          ]
        }
      ]
    },
