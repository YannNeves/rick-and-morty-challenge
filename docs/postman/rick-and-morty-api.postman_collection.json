              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Episodes are sorted by code', function () {",
                  "  const episodes = pm.response.json().episodes;",
                  "  const expected = [...episodes].sort((left, right) => left.code.localeCompare(right.code)).map(item => item.id);",
