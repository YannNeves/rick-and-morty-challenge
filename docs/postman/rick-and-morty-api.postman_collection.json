                  "  const compare = (left, right) => left.name.localeCompare(right.name, 'pt-BR', { sensitivity: 'base', numeric: true }) || left.id - right.id;",
                  "  const expected = [...characters].sort(compare).map(item => item.id);",
                  "  pm.expect(characters.map(item => item.id)).to.eql(expected);",
                  "});"
                ]
