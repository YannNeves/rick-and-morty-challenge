{
  "info": {
    "_postman_id": "be58fc39-2793-4975-bfde-0d041b5c49e5",
    "name": "Rick and Morty Challenge API",
    "description": "Collection de demonstração da API intermediária consumida pelo Flutter. Cobre healthcheck, paginação, filtros, coleções completas, batches, detalhes, relacionamentos, ordenação e erros normalizados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is below 20 seconds', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(20000);",
          "});",
          "pm.test('Response is JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Confirma que o processo da API está disponível."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Service is healthy', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Characters",
      "item": [
        {
          "name": "List characters",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/characters?page=1",
            "description": "Lista personagens paginados, como usado pelo infinite load."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns a character page', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.page).to.eql(1);",
                  "  pm.expect(body.hasNextPage).to.be.a('boolean');",
                  "  pm.expect(body.characters).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter characters by UI fields",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/characters?page=1&name=rick&status=alive&species=human",
            "description": "Exercita os filtros expostos pelo Flutter: Nome, Status e Espécie. A API também aceita type e gender conforme o OpenAPI."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Every result matches the filters', function () {",
                  "  pm.response.json().characters.forEach(function (character) {",
                  "    pm.expect(character.name.toLowerCase()).to.include('rick');",
                  "    pm.expect(character.status.toLowerCase()).to.eql('alive');",
                  "    pm.expect(character.species.toLowerCase()).to.eql('human');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Empty character search",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/characters?page=1&name={{missingCharacterName}}",
            "description": "Um filtro sem correspondência deve virar uma página vazia 200, e não um 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns an empty page', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.totalItems).to.eql(0);",
                  "  pm.expect(body.characters).to.eql([]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all characters sorted",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/characters/all",
            "description": "Agrega todas as páginas com concorrência limitada e ordena globalmente por nome, com desempate por ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Characters are deterministically sorted', function () {",
                  "  const characters = pm.response.json().characters;",
                  "  const compare = (left, right) => left.name.localeCompare(right.name, 'pt-BR', { sensitivity: 'base', numeric: true }) || left.id - right.id;",
                  "  const expected = [...characters].sort(compare).map(item => item.id);",
                  "  pm.expect(characters.map(item => item.id)).to.eql(expected);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get character details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/characters/{{characterId}}",
            "description": "Retorna origem, localização atual e IDs dos episódios no contrato próprio da API."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns detail relationships', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(Number(pm.environment.get('characterId')));",
                  "  pm.expect(body.episodeIds).to.be.an('array');",
                  "  pm.expect(body.origin).to.include.keys('id', 'name');",
                  "  pm.expect(body.location).to.include.keys('id', 'name');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get characters batch",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/characters/batch?ids=1,183,1",
            "description": "Remove IDs duplicados e preserva a ordem solicitada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Deduplicates and preserves order', () => pm.expect(pm.response.json().characters.map(item => item.id)).to.eql([1, 183]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid character id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiBaseUrl}}/characters/zero"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Returns normalized error', () => pm.expect(pm.response.json().error.code).to.eql('BAD_REQUEST'));"
                ]
              }
            }
          ]
        }
      ]
    },
