{
  "info": {
    "_postman_id": "be58fc39-2793-4975-bfde-0d041b5c49e5",
    "name": "Rick and Morty Challenge API",
    "description": "Testes manuais da API intermediaria consumida pelo Flutter. Selecione o environment Local antes de executar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is below 8 seconds', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(8000);",
          "});",
          "pm.test('Response is JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Confirma que o processo da API esta disponivel."
          },
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Service is healthy', () => pm.expect(pm.response.json().status).to.eql('ok')); "]}}]
        }
      ]
    },
    {
      "name": "Characters",
      "item": [
        {
          "name": "List characters",
          "request": {"method":"GET","header":[],"url":"{{apiBaseUrl}}/characters?page=1","description":"Lista personagens paginados."},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns a character page', function () { const body = pm.response.json(); pm.expect(body.page).to.eql(1); pm.expect(body.characters).to.be.an('array'); });"]}}]
        },
        {
          "name": "Filter characters",
          "request": {"method":"GET","header":[],"url":"{{apiBaseUrl}}/characters?page=1&name=rick&status=alive&species=human&gender=male","description":"Filtros podem ser removidos ou alterados na aba Params."},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Every result matches name filter', function () { pm.response.json().characters.forEach(character => pm.expect(character.name.toLowerCase()).to.include('rick')); });"]}}]
        },
        {
          "name": "Get character details",
          "request": {"method":"GET","header":[],"url":"{{apiBaseUrl}}/characters/{{characterId}}","description":"Retorna origem, localizacao e ids de episodios no contrato proprio da API."},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns detail relationships', function () { const body = pm.response.json(); pm.expect(body.id).to.eql(Number(pm.environment.get('characterId'))); pm.expect(body.episodeIds).to.be.an('array'); pm.expect(body.origin).to.be.an('object'); });"]}}]
        },
        {
          "name": "Get characters batch",
          "request": {"method":"GET","header":[],"url":"{{apiBaseUrl}}/characters/batch?ids=1,183,1","description":"Valida deduplicacao e preservacao da ordem solicitada."},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Deduplicates and preserves order', function () { pm.expect(pm.response.json().characters.map(item => item.id)).to.eql([1, 183]); });"]}}]
        },
        {
          "name": "Reject invalid character id",
          "request": {"method":"GET","header":[],"url":"{{apiBaseUrl}}/characters/zero"},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 400', () => pm.response.to.have.status(400));","pm.test('Returns normalized error', () => pm.expect(pm.response.json().error.code).to.eql('BAD_REQUEST')); "]}}]
        }
      ]
    },
    {
      "name": "Episodes",
      "item": [
        {
          "name": "List episodes",
          "request": {"method":"GET","header":[],"url":"{{apiBaseUrl}}/episodes?page=1"},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Returns an episode page', () => pm.expect(pm.response.json().episodes).to.be.an('array')); "]}}]
        },
        {
          "name": "Filter episodes",
          "request": {"method":"GET","header":[],"url":"{{apiBaseUrl}}/episodes?page=1&name=ricklantis&episode=S03E07"},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "Get episode with sorted characters",
          "request": {"method":"GET","header":[],"url":"{{apiBaseUrl}}/episodes/{{episodeId}}?sortCharactersBy=name&characterOrder=asc","description":"Os campos aceitos para ordenacao sao name, id, status e species; a ordem pode ser asc ou desc."},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 200', () => pm.response.to.have.status(200));","pm.test('Characters are sorted by name', function () { const names = pm.response.json().characters.map(item => item.name); const sorted = [...names].sort((a, b) => a.localeCompare(b, 'en', { sensitivity: 'base' })); pm.expect(names).to.eql(sorted); });"]}}]
        },
        {
          "name": "Reject invalid sort field",
          "request": {"method":"GET","header":[],"url":"{{apiBaseUrl}}/episodes/{{episodeId}}?sortCharactersBy=created"},
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status is 400', () => pm.response.to.have.status(400));","pm.test('Returns normalized error', () => pm.expect(pm.response.json().error.code).to.eql('BAD_REQUEST')); "]}}]
        }
      ]
    }
  ]
}
